# --- This backend's own settings ---
PORT=4000
JWT_SECRET=change-me-to-a-long-random-string
APP_DB_PATH=./data/soccerbeast.db

# --- MatchesStatistics integration (vendor-matches-statistics/) ---
# Absolute path to that project's venv Python and football.db, on this same
# machine (see BACKEND_SETUP.md — it runs as a CLI tool, not a service).
MATCHES_STATISTICS_DIR=./vendor-matches-statistics
MATCHES_STATISTICS_PYTHON=./vendor-matches-statistics/venv/bin/python3
MATCHES_STATISTICS_DB_PATH=./vendor-matches-statistics/football.db

# --- livescore-api integration (vendor-livescore-api/, runs as its own service) ---
LIVESCORE_API_BASE_URL=http://127.0.0.1:8000
LIVESCORE_API_KEY=change-me-to-match-livescore-apis-own-.env
