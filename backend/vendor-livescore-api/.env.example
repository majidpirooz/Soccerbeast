# Copy this file to .env and fill in real values before running.

# Secret key your website must send as the "X-API-Key" header on every request.
API_KEY=change-me-to-a-long-random-string

# Where the SQLite database file is stored.
DATABASE_URL=sqlite:///./livescore.db

# Target page to scrape.
TARGET_URL=https://www.varzesh3.com/livescore

# Default snapshot interval in seconds (how often the page is reloaded and saved).
# Can also be changed at runtime via POST /control/config.
DEFAULT_INTERVAL_SECONDS=30

# How often (seconds) we re-scan for dropdowns that closed/appeared and re-open them,
# independent of the full snapshot interval. Usually equal to or smaller than the interval.
DEFAULT_RECHECK_SECONDS=30

# Minimum interval allowed via the API, to stop the service being configured into
# hammering the source site.
MIN_INTERVAL_SECONDS=15

# Set to "true" to also persist each raw HTML snapshot to disk (uses more space, useful
# for debugging/re-parsing later). "false" only keeps the parsed structured data.
SAVE_RAW_HTML=false
RAW_HTML_DIR=./snapshots

# How often (seconds) to check for matches needing a lineup/stats detail-page visit.
DETAIL_CHECK_INTERVAL_SECONDS=60

# How many minutes before kickoff to fetch each match's lineup/formation/coaches.
LINEUP_MINUTES_BEFORE_KICKOFF=10

# Playwright browser: true = headless (recommended on a VPS with no display)
HEADLESS=true
