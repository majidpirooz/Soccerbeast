# Leave unset (or delete this file / don't create .env) to run entirely on
# mock data from src/mock/*.js — every container in src/containers/ falls
# back to mock automatically (see src/api/mockMode.js). Set this once a
# real backend exists per API_CONTRACT.md, and nothing else needs to change.
VITE_API_BASE_URL=http://localhost:3000/api
